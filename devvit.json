{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "lute-roll",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "journeys": true,
    "reddit": {
      "enable": true
    }
  },
  "scheduler": {
    "tasks": {
      "daily-tavern-post": {
        "endpoint": "/internal/cron/daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create Lute Roll Post",
        "description": "Create a new Lute Roll tavern post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Reset My Daily Roll (Dev)",
        "description": "Clear your today's d20 roll on r/lute_roll_dev to test from start",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-daily"
      },
      {
        "label": "Unlock All Relics & Feats (Dev)",
        "description": "Unlock all 48 relics, 15 feats, voices, and Bard wearables on r/lute_roll_dev",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/unlock-all"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "dev": {
    "subreddit": "lute_roll_dev"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
